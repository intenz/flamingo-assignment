// Shared shape with flamingo-triage — same Supabase tables (users/items/…).
// Keep moduleFormat = "cjs" so tsx/Next see model delegates.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  owner
  member
  viewer
}

enum ItemStatus {
  open
  claimed
  resolved
}

enum NotifyOutboxStatus {
  pending
  delivered
  failed
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  memberships  Membership[]
  claimedItems Item[]       @relation("ClaimedBy")

  @@map("users")
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  memberships Membership[]
  items       Item[]

  @@map("workspaces")
}

model Membership {
  id          String @id @default(cuid())
  workspaceId String @map("workspace_id")
  userId      String @map("user_id")
  role        Role

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("memberships")
}

model Item {
  id          String     @id @default(cuid())
  workspaceId String     @map("workspace_id")
  title       String
  body        String     @default("")
  status      ItemStatus @default(open)
  claimedById String?    @map("claimed_by_id")
  claimedAt   DateTime?  @map("claimed_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  claimedBy    User?          @relation("ClaimedBy", fields: [claimedById], references: [id], onDelete: SetNull)
  notifyOutbox NotifyOutbox[]

  @@index([workspaceId, status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([workspaceId, id])
  @@index([status, claimedAt])
  @@map("items")
}

model NotifyOutbox {
  id          String             @id @default(cuid())
  itemId      String             @map("item_id")
  status      NotifyOutboxStatus @default(pending)
  attempts    Int                @default(0)
  lastError   String?            @map("last_error")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  deliveredAt DateTime?          @map("delivered_at")

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("notify_outbox")
}

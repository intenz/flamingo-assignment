// Triage queue domain — NotifyOutbox for R3 durable notify delivery.
// IDs are opaque strings (e.g. usr_alice, itm_…); assigned in seed / app code.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  owner
  member
  viewer
}

enum ItemStatus {
  open
  claimed
  resolved
}

enum NotifyOutboxStatus {
  pending
  sent
  failed
}

model User {
  id        String   @id
  name      String
  createdAt DateTime @default(now())

  memberships Membership[]
  claims      Item[]       @relation("ItemClaimant")
}

model Workspace {
  id        String   @id
  name      String
  createdAt DateTime @default(now())

  memberships Membership[]
  items       Item[]
}

model Membership {
  id          String         @id
  workspaceId String
  userId      String
  role        MembershipRole
  createdAt   DateTime       @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Item {
  id           String     @id
  workspaceId  String
  title        String
  body         String     @default("")
  status       ItemStatus @default(open)
  claimedById  String?
  claimedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  claimedBy    User?          @relation("ItemClaimant", fields: [claimedById], references: [id], onDelete: SetNull)
  notifyOutbox NotifyOutbox[]

  // Queue list / keyset pagination (R4): newest-first stable order
  @@index([workspaceId, createdAt, id])
  // Claim / open-queue scans
  @@index([workspaceId, status, createdAt, id])
  @@index([claimedById])
}

/// Durable notify intent — resolve writes a row; drain calls flaky notify().
/// At-least-once: retries while pending until sent (or max attempts → failed).
model NotifyOutbox {
  id        String             @id
  itemId    String
  message   String
  status    NotifyOutboxStatus @default(pending)
  attempts  Int                @default(0)
  lastError String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  sentAt    DateTime?

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([itemId])
}

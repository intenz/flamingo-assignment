# Local development (default): Prisma Dev Postgres
# Start: npm run db:up   → prints/uses a local URL on a high port
DATABASE_URL="postgres://postgres:postgres@localhost:51214/flamingo_assignment?sslmode=disable"

# Later (Supabase / Vercel): swap to your pooler URI instead, e.g.
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# HMAC secret for signed session cookies (long random string)
SESSION_SECRET="replace-with-a-long-random-string"

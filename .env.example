# Local development (default): Prisma Dev Postgres
# Start: npm run db:up
# Note: `prisma dev` listens on a high port; use the URL it prints (often .../template1).
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# Later (Supabase / Vercel): swap to your pooler URI instead, e.g.
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# HMAC secret for signed session cookies (long random string)
SESSION_SECRET="replace-with-a-long-random-string"
